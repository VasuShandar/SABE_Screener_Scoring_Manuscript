/* SABE SCREENER SCORING - COMPLETE ANALYSIS PIPELINE            */
/* Development and Scoring of a Diet Quality Screener for        */
/* Hispanic/Latino Adults Using NHANES Data                      */
/*                                                                 */
/* Pichardo, Shandar, Quinn, McReynolds, Townsend Creasy, Wu,    */
/* Compher. Penn Medicine / Penn Nursing.                        */
/*                                                                 */
/* This script reproduces every table and figure in:             */
/*   - SABE_Screener_Scoring_Manuscript                          */
/*   - SABE_Screener_Scoring_Tables_and_Figures                  */
/*                                                                 */
/*****************************************************************/


/*****************************************************************/
/* SECTION 0: SETUP AND IMPORT                                    */
/*****************************************************************/

libname rawdata "/workspaces/myfolder/sas-viya-workbench-examples/sabe_project/raw_data";
libname outdata "/workspaces/myfolder/sas-viya-workbench-examples/sabe_project/output";

%let outpath = /workspaces/myfolder/sas-viya-workbench-examples/sabe_project/output;

proc import
    datafile="/workspaces/myfolder/sas-viya-workbench-examples/sabe_project/raw_data/NHANES_1718_export.csv"
    out=outdata.nhanes_1718 dbms=csv replace;
    getnames=yes;
run;

proc import
    datafile="/workspaces/myfolder/sas-viya-workbench-examples/sabe_project/raw_data/NHANES_1516_export.csv"
    out=outdata.nhanes_1516 dbms=csv replace;
    getnames=yes;
run;


/*****************************************************************/
/* SECTION 1: SCREENER DISCRETIZATION MACRO                       */
/* Converts continuous FPED intake (servings/day) to a 0-5 scale  */
/*   0 servings         -> 0                                      */
/*   0  to <1 serving   -> 1                                      */
/*   1  to <2 servings  -> 2                                      */
/*   2  to <3 servings  -> 3                                      */
/*   3  to <4 servings  -> 4                                      */
/*   >=4 servings       -> 5                                      */
/*****************************************************************/

%macro create_screen_var(var);
    if &var. ne . then do;
        if &var.=0 then screen_&var.=0;
        if 0<&var.<1 then screen_&var.=1;
        if 1<=&var.<2 then screen_&var.=2;
        if 2<=&var.<3 then screen_&var.=3;
        if 3<=&var.<4 then screen_&var.=4;
        if 4<=&var. then screen_&var.=5;
    end;
%mend create_screen_var;


/*****************************************************************/
/* SECTION 2: MASTER PREP MACRO (applied identically to both      */
/* NHANES cycles: 2017-18 development sample, 2015-16 validation  */
/* sample)                                                         */
/*****************************************************************/

%macro prep_sabe_cycle(in=, out=);

data &out.;
set &in.;

    /* --- Restrict to Hispanic/Latino adults --- */
    if RIDAGEYR < 18 then delete;
    if RIDRETH3 not in (1,2) then delete;

    /* --- Unit conversions: ounce-equivalents -> 3-oz servings --- */
    pf_meat_3      = pf_meat/3;
    pf_curedmeat_3 = pf_curedmeat/3;
    pf_poult_3     = pf_poult/3;

    /* --- Combined FPED variables --- */
    seafood          = PF_SEAFD_HI + PF_SEAFD_LOW;
    seafood_3        = seafood/3;
    plant_prot       = PF_SOY + PF_LEGUMES;
    desserts         = ww_dessert_n + ww_bakery_n;
    v_redor_combined = V_REDOR_TOMATO + V_REDOR_OTHER;   /* red/orange veg + tomatoes, per Methods */
    coffee_tea       = fcat_7302 + fcat_7304;             /* not currently scored; retained for completeness */

    /* --- Discretize all continuous screener items to 0-5 scale --- */
    %create_screen_var(f_juice);
    %create_screen_var(f_other);
    %create_screen_var(v_drkgr);
    %create_screen_var(v_redor_other);
    %create_screen_var(v_redor_combined);
    %create_screen_var(g_whole);
    %create_screen_var(g_refined);
    %create_screen_var(d_milk);
    %create_screen_var(d_yogurt);
    %create_screen_var(d_cheese);
    %create_screen_var(pf_eggs);
    %create_screen_var(pf_poult_3);
    %create_screen_var(PF_NUTSDS);
    %create_screen_var(pf_meat_3);
    %create_screen_var(pf_curedmeat_3);
    %create_screen_var(DBD900_daily);
    %create_screen_var(ww_sweetbev_n);
    %create_screen_var(ww_Savory_n);
    %create_screen_var(seafood_3);
    %create_screen_var(plant_prot);
    %create_screen_var(desserts);
    %create_screen_var(coffee_tea);

    /* --- Yes/No behavioral items (from FPED food category flags) --- */
    if fcat_8802=0 & fcat_8008=0 then yn_screen_sugar_honey=0;
    if fcat_8802>0 or fcat_8008>0 then yn_screen_sugar_honey=1;
    if fcat_8804 ne . then yn_screen_artif_sweet = (fcat_8804>0);
    if fcat_8008 ne . then yn_screen_cream       = (fcat_8008>0);
    if fcat_1002=0 & fcat_1820=0 & fcat_1822=0 & fcat_1604=0 then yn_screen_full_fat=0;
    if (fcat_1002>0 or fcat_1820>0 or fcat_1822>0 or fcat_1604>0) then yn_screen_full_fat=1;
    if fcat_8002 ne . then yn_screen_butter_gravy = (fcat_8002>0);
    if fcat_8012 ne . then yn_screen_olive_veg_oil = (fcat_8012>0);

    /* --- Exclude invalid/missing dietary recalls --- */
    if HEI2015_TOTAL_SCORE = 0 then delete;   /* HEI-2020 total score, as pre-calculated in the analytic file */
    if DR1TKCAL = . then delete;

    /* ============================================================ */
    /* SABE SIMPLE SCORE (Table 2 / Supplemental Table 2)            */
    /* 9 forward-scored items (0-5 pts each) + 3 reverse-scored      */
    /* items (15 - sum, yielding 0-5 pts each). Range: 0-60.         */
    /* ============================================================ */
    score_sabe =
        sum(screen_f_juice, screen_f_other, screen_v_drkgr,
            screen_v_redor_combined, screen_g_whole, screen_d_milk,
            screen_PF_NUTSDS, screen_seafood_3, screen_plant_prot)
        + (15 - sum(screen_g_refined, screen_d_cheese,
                    screen_ww_sweetbev_n));

    /* ============================================================ */
    /* SABE REGRESSION-WEIGHTED SCORE                                 */
    /* Coefficients from PROC REG of HEI-2020 total score on all      */
    /* 24 screener items (18 continuous + 6 yes/no; 2017-18           */
    /* development sample), using the COMBINED red/orange veg +       */
    /* tomato variable. This is the same model reported in            */
    /* Supplemental Table 3 below. Confirmed: correlations of this    */
    /* score with HEI-2020/AHEI-2010 in both cycles match Table 2.    */
    /* ============================================================ */
    score_sabe_reg =
        53.76751
        + (screen_f_juice          *  2.52694)
        + (screen_f_other          *  3.48910)
        + (screen_v_drkgr          *  2.62739)
        + (screen_v_redor_combined *  0.99750)
        + (screen_g_whole          *  2.75627)
        + (screen_g_refined        * -2.67174)
        + (screen_d_milk           *  1.26504)
        + (screen_d_yogurt         *  3.72683)
        + (screen_d_cheese         * -2.14767)
        + (screen_pf_eggs          *  0.49836)
        + (screen_pf_poult_3       *  0.38900)
        + (screen_PF_NUTSDS        *  2.14975)
        + (screen_pf_meat_3        * -1.31956)
        + (screen_pf_curedmeat_3   * -1.61512)
        + (screen_seafood_3        *  1.23897)
        + (screen_plant_prot       *  2.80066)
        + (screen_ww_sweetbev_n    * -0.82875)
        + (screen_desserts         * -1.43634)
        + (yn_screen_olive_veg_oil *  2.60273)
        + (yn_screen_full_fat      * -2.43796)
        + (yn_screen_butter_gravy  * -5.05368)
        + (yn_screen_sugar_honey   *  0.40486)
        + (yn_screen_artif_sweet   *  0.09025)
        + (yn_screen_cream         * -0.51406);

    /* ============================================================ */
    /* AHEI-2010 COMPONENTS (Chiuve et al. 2012)                      */
    /* All components scored 0-10 except sodium (decile-ranked below) */
    /* ============================================================ */
    ahei_veg_intake = V_TOTAL - V_STARCHY_TOTAL;
    ahei_veg        = min(10, max(0, ((ahei_veg_intake/0.5)/5) * 10));

    ahei_fruit = min(10, max(0, ((F_OTHER/0.5)/4) * 10));

    ahei_wg_grams = G_WHOLE * 16;
    if RIAGENDR = 2 then ahei_wholegrain = min(10, max(0, (ahei_wg_grams/75) * 10));
    else                 ahei_wholegrain = min(10, max(0, (ahei_wg_grams/90) * 10));

    ahei_ssb_intake = F_JUICE + ww_sweetbev_n;
    ahei_ssb        = min(10, max(0, (1 - ahei_ssb_intake) * 10));

    ahei_nuts_intake = PF_NUTSDS + PF_LEGUMES;
    ahei_nuts        = min(10, max(0, ahei_nuts_intake * 10));

    ahei_meat_serv = (PF_MEAT/4) + (PF_CUREDMEAT/1.5);
    ahei_meat      = min(10, max(0, ((1.5 - ahei_meat_serv)/1.5) * 10));

    if DR1TP205 ne . and DR1TP226 ne . then do;
        ahei_omega3_mg = (DR1TP205 + DR1TP226) * 1000;
        ahei_omega3    = min(10, max(0, (ahei_omega3_mg/250) * 10));
    end;
    else ahei_omega3 = .;

    if DR1TPFAT ne . and DR1TKCAL > 0 then do;
        ahei_pufa_g   = DR1TPFAT - DR1TP205 - DR1TP226;
        ahei_pufa_pct = (ahei_pufa_g * 9 / DR1TKCAL) * 100;
        ahei_pufa     = min(10, max(0, ((ahei_pufa_pct - 2)/(10-2)) * 10));
    end;
    else ahei_pufa = .;

    ahei_sodium_raw = DR1TSODI;   /* ranked into deciles after this data step */

    if A_DRINKS = . then ahei_alcohol = .;
    else if A_DRINKS = 0 then ahei_alcohol = 2.5;
    else if RIAGENDR = 2 then do;   /* women */
        if 0.5 <= A_DRINKS <= 1.5 then ahei_alcohol = 10;
        else if A_DRINKS < 0.5    then ahei_alcohol = max(0, (A_DRINKS/0.5) * 10);
        else                           ahei_alcohol = max(0, ((2.5 - A_DRINKS)/(2.5-1.5)) * 10);
    end;
    else do;   /* men */
        if 0.5 <= A_DRINKS <= 2.0 then ahei_alcohol = 10;
        else if A_DRINKS < 0.5    then ahei_alcohol = max(0, (A_DRINKS/0.5) * 10);
        else                           ahei_alcohol = max(0, ((3.5 - A_DRINKS)/(3.5-2.0)) * 10);
    end;

run;

/* --- AHEI sodium: decile-ranked, reverse-scored (higher sodium = lower score) --- */
proc rank data=&out. out=&out. groups=10;
    var ahei_sodium_raw;
    ranks sodium_decile;
run;

data &out.;
set &out.;
    ahei_sodium = (9 - sodium_decile) / 9 * 10;

    if DR1TP205=. or DR1TP226=. or DR1TPFAT=. or DR1TSODI=. or A_DRINKS=.
        then AHEI_TOTAL = .;
        else AHEI_TOTAL = sum(ahei_veg, ahei_fruit, ahei_wholegrain, ahei_ssb,
                               ahei_nuts, ahei_meat, ahei_omega3, ahei_pufa,
                               ahei_sodium, ahei_alcohol);
run;

%mend prep_sabe_cycle;

%prep_sabe_cycle(in=outdata.nhanes_1718, out=outdata.sabe_1718);
%prep_sabe_cycle(in=outdata.nhanes_1516, out=outdata.sabe_1516);

/* --- Sanity check both cycles before moving to deliverables --- */
title "VERIFY: 2017-18 development sample";
proc means data=outdata.sabe_1718 n mean median min max;
    var score_sabe score_sabe_reg HEI2015_TOTAL_SCORE AHEI_TOTAL;
run;

title "VERIFY: 2015-16 validation sample";
proc means data=outdata.sabe_1516 n mean median min max;
    var score_sabe score_sabe_reg HEI2015_TOTAL_SCORE AHEI_TOTAL;
run;
title;


/*****************************************************************/
/* FIGURE 1: CONSORT-STYLE FLOW DIAGRAM COUNTS                    */
/* Run for both cycles to populate the exclusion flow diagram.    */
/*****************************************************************/

%macro consort_counts(in=, label=);

    title "FIGURE 1 counts: &label - sequential sample sizes";
    proc sql;
        select count(*) as total_raw from &in.;
        select count(*) as adults_18plus from &in. where RIDAGEYR >= 18;
        select count(*) as hispanic_only from &in.
            where RIDAGEYR >= 18 and RIDRETH3 in (1,2);
        select count(*) as valid_weights from &in.
            where RIDAGEYR >= 18 and RIDRETH3 in (1,2) and WTDRD1 > 0;
        select count(*) as valid_calories from &in.
            where RIDAGEYR >= 18 and RIDRETH3 in (1,2) and WTDRD1 > 0 and DR1TKCAL ne .;
        select count(*) as final_sample from &in.
            where RIDAGEYR >= 18 and RIDRETH3 in (1,2) and WTDRD1 > 0
              and DR1TKCAL ne . and HEI2015_TOTAL_SCORE > 0;
    quit;

    title "FIGURE 1 counts: &label - number excluded at each step";
    proc sql;
        select
            sum(RIDAGEYR < 18) as excluded_age,
            sum(RIDRETH3 not in (1,2) and RIDAGEYR >= 18) as excluded_ethnicity,
            sum(WTDRD1 <= 0 and RIDAGEYR >= 18 and RIDRETH3 in (1,2)) as excluded_weights,
            sum(DR1TKCAL = . and RIDAGEYR >= 18 and RIDRETH3 in (1,2) and WTDRD1 > 0) as excluded_calories,
            sum(HEI2015_TOTAL_SCORE = 0 and RIDAGEYR >= 18 and RIDRETH3 in (1,2)
                and WTDRD1 > 0 and DR1TKCAL ne .) as excluded_hei
        from &in.;
    quit;
    title;

%mend consort_counts;

%consort_counts(in=outdata.nhanes_1718, label=2017-18 development);
%consort_counts(in=outdata.nhanes_1516, label=2015-16 validation);


