/*****************************************************************/
/* SUPPLEMENTAL TABLE 1: HEI/AHEI COMPONENTS AS % OF MAXIMUM,      */
/* BY HISPANIC SUBGROUP vs NON-HISPANIC (full NHANES 2017-18       */
/* sample, not restricted to Hispanic/Latino adults)               */
/*****************************************************************/

data outdata.nhanes_all_adults;
set outdata.nhanes_1718;

    if RIDAGEYR < 18 then delete;
    if WTDRD1 <= 0 then delete;
    if DR1TKCAL = . then delete;
    if HEI2015_TOTAL_SCORE = 0 then delete;

    length ethnicity $25;
    if RIDRETH3 = 1 then ethnicity = '1-Mexican American';
    else if RIDRETH3 = 2 then ethnicity = '2-Other Hispanic';
    else ethnicity = '3-Non-Hispanic';

    /* HEI-2020 components as % of maximum (0-5 components x20; 0-10 components x10) */
    pct_hei_total        = HEI2015_TOTAL_SCORE;
    pct_hei_totalveg     = (HEI2015C1_TOTALVEG / 5) * 100;
    pct_hei_greenbeans   = (HEI2015C2_GREEN_AND_BEAN / 5) * 100;
    pct_hei_totalfruit   = (HEI2015C3_TOTALFRUIT / 5) * 100;
    pct_hei_wholefruit   = (HEI2015C4_WHOLEFRUIT / 5) * 100;
    pct_hei_wholegrain   = (HEI2015C5_WHOLEGRAIN / 10) * 100;
    pct_hei_dairy        = (HEI2015C6_TOTALDAIRY / 10) * 100;
    pct_hei_totprot      = (HEI2015C7_TOTPROT / 5) * 100;
    pct_hei_seaplant     = (HEI2015C8_SEAPLANT_PROT / 5) * 100;
    pct_hei_fattyacid    = (HEI2015C9_FATTYACID / 10) * 100;
    pct_hei_sodium       = (HEI2015C10_SODIUM / 10) * 100;
    pct_hei_refinedgrain = (HEI2015C11_REFINEDGRAIN / 10) * 100;
    pct_hei_sfat         = (HEI2015C12_SFAT / 10) * 100;
    pct_hei_addsug       = (HEI2015C13_ADDSUG / 10) * 100;

    /* AHEI-2010 components, recomputed on the full sample */
    ahei_veg_intake = V_TOTAL - V_STARCHY_TOTAL;
    ahei_veg        = min(10, max(0, ((ahei_veg_intake/0.5)/5) * 10));
    ahei_fruit      = min(10, max(0, ((F_OTHER/0.5)/4) * 10));
    ahei_wg_grams   = G_WHOLE * 16;
    if RIAGENDR = 2 then ahei_wholegrain = min(10, max(0, (ahei_wg_grams/75) * 10));
    else                 ahei_wholegrain = min(10, max(0, (ahei_wg_grams/90) * 10));
    ahei_ssb_intake  = F_JUICE + ww_sweetbev_n;
    ahei_ssb         = min(10, max(0, (1 - ahei_ssb_intake) * 10));
    ahei_nuts_intake = PF_NUTSDS + PF_LEGUMES;
    ahei_nuts        = min(10, max(0, ahei_nuts_intake * 10));
    ahei_meat_serv   = (PF_MEAT/4) + (PF_CUREDMEAT/1.5);
    ahei_meat        = min(10, max(0, ((1.5 - ahei_meat_serv)/1.5) * 10));
    if DR1TP205 ne . and DR1TP226 ne . then do;
        ahei_omega3_mg = (DR1TP205 + DR1TP226) * 1000;
        ahei_omega3    = min(10, max(0, (ahei_omega3_mg/250) * 10));
    end; else ahei_omega3 = .;
    if DR1TPFAT ne . and DR1TKCAL > 0 then do;
        ahei_pufa_pct = ((DR1TPFAT - DR1TP205 - DR1TP226) * 9 / DR1TKCAL) * 100;
        ahei_pufa     = min(10, max(0, ((ahei_pufa_pct - 2)/(10-2)) * 10));
    end; else ahei_pufa = .;
    ahei_sodium_raw = DR1TSODI;
    if A_DRINKS = . then ahei_alcohol = .;
    else if A_DRINKS = 0 then ahei_alcohol = 2.5;
    else if RIAGENDR = 2 then do;
        if 0.5 <= A_DRINKS <= 1.5 then ahei_alcohol = 10;
        else if A_DRINKS < 0.5    then ahei_alcohol = max(0, (A_DRINKS/0.5) * 10);
        else                           ahei_alcohol = max(0, ((2.5 - A_DRINKS)/(2.5-1.5)) * 10);
    end; else do;
        if 0.5 <= A_DRINKS <= 2.0 then ahei_alcohol = 10;
        else if A_DRINKS < 0.5    then ahei_alcohol = max(0, (A_DRINKS/0.5) * 10);
        else                           ahei_alcohol = max(0, ((3.5 - A_DRINKS)/(3.5-2.0)) * 10);
    end;

    if DR1TP205=. or DR1TP226=. or DR1TPFAT=. or DR1TSODI=. or A_DRINKS=.
        then AHEI_TOTAL_noSodium = .;
        else AHEI_TOTAL_noSodium = sum(ahei_veg, ahei_fruit, ahei_wholegrain, ahei_ssb,
                                        ahei_nuts, ahei_meat, ahei_omega3, ahei_pufa,
                                        ahei_alcohol);

    pct_ahei_veg        = (ahei_veg / 10) * 100;
    pct_ahei_fruit      = (ahei_fruit / 10) * 100;
    pct_ahei_wholegrain = (ahei_wholegrain / 10) * 100;
    pct_ahei_ssb        = (ahei_ssb / 10) * 100;
    pct_ahei_nuts       = (ahei_nuts / 10) * 100;
    pct_ahei_meat       = (ahei_meat / 10) * 100;
    pct_ahei_omega3     = (ahei_omega3 / 10) * 100;
    pct_ahei_pufa       = (ahei_pufa / 10) * 100;

run;

/* Sodium decile ranking + final AHEI total (needs the ranked sodium score) */
proc rank data=outdata.nhanes_all_adults out=outdata.nhanes_all_adults groups=10;
    var ahei_sodium_raw;
    ranks sodium_decile;
run;

data outdata.nhanes_all_adults;
set outdata.nhanes_all_adults;
    ahei_sodium = (9 - sodium_decile) / 9 * 10;
    if AHEI_TOTAL_noSodium ne . then AHEI_TOTAL = AHEI_TOTAL_noSodium + ahei_sodium;
        else AHEI_TOTAL = .;
    pct_ahei_total = AHEI_TOTAL;
run;

