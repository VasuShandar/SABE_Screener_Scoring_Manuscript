/*****************************************************************/
/* FIGURE 3 (source data) & FIGURE 5 (source data):                */
/* Correlation matrices exported for the R/ggplot2 heatmaps.       */
/*                                                                 */
/* IMPORTANT: this exports exactly the 16 items (score_sabe + 15   */
/* named screener items) used by figures_heatmap_hei.R and         */
/* figures_heatmap_ahei.R - NOT all 24 screener items. This        */
/* matches the item_order list in those R scripts. One CSV per     */
/* cycle per index (not split into continuous/yes-no files).       */
/*****************************************************************/

%macro export_heatmap_corr(in=, target=, filename=);

    proc corr data=&in.
        %if &target = AHEI %then %do; (where=(AHEI_TOTAL > 0)) %end;
        spearman outp=_heatcorr_ noprint;
        var score_sabe
            screen_f_other screen_g_whole screen_PF_NUTSDS
            screen_plant_prot screen_v_drkgr
            yn_screen_olive_veg_oil yn_screen_full_fat
            screen_seafood_3 screen_v_redor_combined
            screen_f_juice screen_d_milk
            yn_screen_butter_gravy
            screen_ww_sweetbev_n screen_d_cheese screen_g_refined;
        %if &target = HEI %then %do;
            with HEI2015_TOTAL_SCORE HEI2015C9_FATTYACID HEI2015C8_SEAPLANT_PROT
                 HEI2015C6_TOTALDAIRY HEI2015C7_TOTPROT HEI2015C5_WHOLEGRAIN
                 HEI2015C4_WHOLEFRUIT HEI2015C3_TOTALFRUIT HEI2015C2_GREEN_AND_BEAN
                 HEI2015C1_TOTALVEG HEI2015C13_ADDSUG HEI2015C12_SFAT
                 HEI2015C11_REFINEDGRAIN HEI2015C10_SODIUM;
        %end;
        %else %do;
            with AHEI_TOTAL ahei_veg ahei_fruit ahei_wholegrain ahei_ssb ahei_nuts
                 ahei_meat ahei_omega3 ahei_pufa ahei_sodium ahei_alcohol;
        %end;
    run;

    data _heat_tmp_(type=corr);
        set _heatcorr_(type=corr);
        where _TYPE_ = 'CORR';
    run;

    proc export data=_heat_tmp_
        outfile="&outpath./&filename..csv"
        dbms=csv replace;
    run;

%mend export_heatmap_corr;

/* Figure 3 source data: HEI heatmap, one file per cycle */
%export_heatmap_corr(in=outdata.sabe_1718, target=HEI,  filename=corr_hei_1718);
%export_heatmap_corr(in=outdata.sabe_1516, target=HEI,  filename=corr_hei_1516);

/* Figure 5 source data: AHEI heatmap, one file per cycle */
%export_heatmap_corr(in=outdata.sabe_1718, target=AHEI, filename=corr_ahei_1718);
%export_heatmap_corr(in=outdata.sabe_1516, target=AHEI, filename=corr_ahei_1516);


